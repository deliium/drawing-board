{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawing-board.local/schemas/hiragana5-pack.schema.json",
  "title": "Hiragana5 content pack invariants",
  "description": "Documented shape for v1 pack files. Runtime validation lives in internal/curriculum.",
  "type": "object",
  "required": ["manifest", "characters", "strokes", "traces", "review"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["packId", "contentVersion", "setId", "characterCount", "schemaVersion", "reviewStatus", "contentHash", "lesson"],
      "properties": {
        "packId": { "const": "hiragana5" },
        "contentVersion": { "type": "string", "minLength": 1 },
        "setId": { "const": "hiragana5" },
        "characterCount": { "const": 5 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "reviewStatus": { "enum": ["draft", "reviewed", "published"] },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "lesson": {
          "type": "object",
          "required": ["id", "code", "title"],
          "properties": {
            "id": { "type": "string" },
            "code": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    }
  }
}
